# Copy to `.env` (never commit `.env`).

# --- API ---
EXACT_API_HOST=0.0.0.0
EXACT_API_PORT=8080

# --- Models (open-source, ≤8B per EXACT rules) ---
EXACT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EXACT_MATH_MODEL_ID=Qwen/Qwen2.5-Math-7B-Instruct

# Self-hosted vLLM server.
EXACT_LLM_BASE_URL=http://127.0.0.1:8000/v1
EXACT_LLM_API_KEY=exact-local-token

# --- Dedicated Type 1 parser model ---
EXACT_TYPE1_PARSER_BASE_URL=http://127.0.0.1:8001/v1
EXACT_TYPE1_PARSER_MODEL=type1-parser
EXACT_TYPE1_PARSER_API_KEY=exact-parser-token
EXACT_TYPE1_PARSER_CONCURRENCY=32
EXACT_TYPE1_PARSER_TIMEOUT_SECONDS=30
EXACT_TYPE1_PARSER_MAX_RETRIES=2
EXACT_TYPE1_PARSER_MAX_TOKENS=80

# Parser vLLM deployment settings used by scripts/serve_type1_parser.sh.
EXACT_TYPE1_PARSER_SOURCE_MODEL=Qwen/Qwen3-1.7B
EXACT_TYPE1_PARSER_SERVER_DEVICE=auto
EXACT_TYPE1_PARSER_SERVER_HOST=127.0.0.1
EXACT_TYPE1_PARSER_SERVER_PORT=8001
EXACT_TYPE1_PARSER_SERVER_MAX_MODEL_LEN=4096
EXACT_TYPE1_PARSER_SERVER_MAX_NUM_SEQS=64
EXACT_TYPE1_PARSER_SERVER_MAX_NUM_BATCHED_TOKENS=8192
EXACT_TYPE1_PARSER_SERVER_GPU_MEMORY_UTILIZATION=0.25
EXACT_TYPE1_PARSER_SERVER_DTYPE=auto
EXACT_TYPE1_PARSER_SERVER_QUANTIZATION=
EXACT_TYPE1_PARSER_SERVER_TENSOR_PARALLEL_SIZE=1
# On a two-GPU host, isolate the parser on GPU 0.
# EXACT_TYPE1_PARSER_SERVER_CUDA_VISIBLE_DEVICES=0
EXACT_TYPE1_PARSER_SERVER_CPU_KVCACHE_SPACE=1
EXACT_TYPE1_PARSER_SERVER_CPU_RESERVED_CPUS=1
EXACT_TYPE1_PARSER_SERVER_CPU_IMAGE=vllm/vllm-openai-cpu:latest-x86_64
# EXACT_TYPE1_PARSER_SERVER_DOCKER_CONTEXT=default
# EXACT_TYPE1_PARSER_SERVER_VLLM_BIN=/path/to/vllm

# Main vLLM deployment settings used by scripts/serve_exact_api.sh.
# On a two-GPU host, isolate the main model on GPU 1 and keep tensor
# parallelism at 1 when the model fits on one GPU.
# VLLM_CUDA_VISIBLE_DEVICES=1
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_GPU_MEMORY_UTILIZATION=0.90

# Offline plumbing tests without GPU LLM server
MOCK_LLM=0

EXACT_TEMPERATURE=0.1
EXACT_MAX_RETRIES=3
