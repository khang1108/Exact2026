# Copy to `.env` (never commit `.env`).

# --- API ---
EXACT_API_HOST=0.0.0.0
EXACT_API_PORT=8080

# --- Models (open-source, ≤8B per EXACT rules) ---
EXACT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EXACT_MATH_MODEL_ID=Qwen/Qwen2.5-Math-7B-Instruct

# OpenAI-compatible base URL (vLLM / llama.cpp server). Leave unset if using MOCK_LLM only.
EXACT_LLM_BASE_URL=http://127.0.0.1:8000/v1
EXACT_LLM_API_KEY=exact-local-token

# Groq backend key used by configs with api_key_env = "GROQ_API_KEY".
GROQ_API_KEY=gsk_replace_me

# Offline plumbing tests without GPU LLM server
MOCK_LLM=0

EXACT_TEMPERATURE=0.1
EXACT_MAX_RETRIES=3
