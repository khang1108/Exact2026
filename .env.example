# ============================================================
# EXACT 2026 local deployment: 2x NVIDIA L40 (48 GiB each)
# ============================================================
#
# GPU 0: dedicated Type 1 parser vLLM on port 8001
# GPU 1: dedicated main vLLM on port 8000
# CPU:   EXACT FastAPI on port 8080
#
# This file is ignored by git. Keep local secrets here only.


# ============================================================
# HuggingFace credentials
# ============================================================

# Required for gated models (e.g. meta-llama/Llama-3.1-8B-Instruct).
# setup.sh will prompt for this if not set in the shell environment.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ============================================================
# EXACT API
# ============================================================

EXACT_ENVIRONMENT=local
EXACT_API_HOST=0.0.0.0
EXACT_API_PORT=8080
EXACT_LOG_LEVEL=INFO
EXACT_JSON_LOGS=false

# Public HTTPS hostname tunneled to the EXACT API. The committee checks:
#   curl ${EXACT_COMMITTEE_VLLM_HOST}/v1/models
EXACT_COMMITTEE_VLLM_HOST=https://api.iamphuckhang.dev


# ============================================================
# Data and artifacts
# ============================================================

EXACT_DEFAULT_SEED=42


# ============================================================
# Model IDs
# ============================================================

# Application-facing served name of the main vLLM model.
EXACT_LLM_MODEL=qwen-main

# Kept for routing/config reference. It is not started as another server.
EXACT_MATH_MODEL_ID=Qwen/Qwen2.5-Math-7B-Instruct


# ============================================================
# Main LLM client
# ============================================================

EXACT_LLM_BASE_URL=http://127.0.0.1:8000/v1
EXACT_LLM_API_KEY=exact-local-token
EXACT_LLM_TIMEOUT_SECONDS=120
EXACT_MAX_RETRIES=2


# ============================================================
# Main vLLM server: dedicated GPU 1
# Used by scripts/serve_exact_api.sh
# ============================================================

VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_SERVED_MODEL_NAME=qwen-main
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_API_KEY=exact-local-token

VLLM_CUDA_VISIBLE_DEVICES=1
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_MAX_MODEL_LEN=8192
VLLM_DTYPE=auto
VLLM_QUANTIZATION=

# Keep eager mode enabled on virtualized GPU hosts. Set to 0 only after
# confirming CUDA graph capture is stable on the target L40 machine.
VLLM_ENFORCE_EAGER=1


# ============================================================
# Dedicated Type 1 parser client
# ============================================================

EXACT_TYPE1_PARSER_BASE_URL=http://127.0.0.1:8001/v1
EXACT_TYPE1_PARSER_MODEL=type1-parser
EXACT_TYPE1_PARSER_API_KEY=exact-parser-token
EXACT_TYPE1_PARSER_CONCURRENCY=16
EXACT_TYPE1_PARSER_TIMEOUT_SECONDS=90
EXACT_TYPE1_PARSER_MAX_RETRIES=2
EXACT_TYPE1_PARSER_MAX_TOKENS=512


# ============================================================
# Dedicated Type 1 parser vLLM server: dedicated GPU 0
# Used by scripts/serve_exact_api.sh
# ============================================================

# Base model for the Type 1 parser vLLM.
# Switch to Llama-3.1-8B-Instruct when using a LoRA adapter targeting LLaMA.
EXACT_TYPE1_PARSER_SOURCE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LoRA adapter for FOL parsing consistency (optional).
# ASethi04/llama-3.1-8b-mmlu-formal_logic-lora:
#   - Real LoRA adapter (adapter_config.json + adapter_model.safetensors)
#   - Base: meta-llama/Llama-3.1-8B-Instruct
#   - Trained on MMLU formal logic reasoning
EXACT_TYPE1_PARSER_LORA_ADAPTER=ASethi04/llama-3.1-8b-mmlu-formal_logic-lora
# Maximum LoRA rank. Must match the adapter's rank (common values: 16, 32, 64).
EXACT_TYPE1_PARSER_LORA_MAX_RANK=64
EXACT_TYPE1_PARSER_SERVER_DEVICE=auto
EXACT_TYPE1_PARSER_SERVER_HOST=127.0.0.1
EXACT_TYPE1_PARSER_SERVER_PORT=8001

EXACT_TYPE1_PARSER_SERVER_CUDA_VISIBLE_DEVICES=0
EXACT_TYPE1_PARSER_SERVER_TENSOR_PARALLEL_SIZE=1
EXACT_TYPE1_PARSER_SERVER_GPU_MEMORY_UTILIZATION=0.75
EXACT_TYPE1_PARSER_SERVER_MAX_MODEL_LEN=4096
EXACT_TYPE1_PARSER_SERVER_MAX_NUM_SEQS=16
EXACT_TYPE1_PARSER_SERVER_MAX_NUM_BATCHED_TOKENS=8192
EXACT_TYPE1_PARSER_SERVER_DTYPE=auto
EXACT_TYPE1_PARSER_SERVER_QUANTIZATION=
EXACT_TYPE1_PARSER_SERVER_ENFORCE_EAGER=1

EXACT_TYPE1_TRANSLATOR=single_pass


# ============================================================
# Parser CPU fallback
# Only used when EXACT_TYPE1_PARSER_SERVER_DEVICE=cpu
# ============================================================

EXACT_TYPE1_PARSER_SERVER_CPU_KVCACHE_SPACE=1
EXACT_TYPE1_PARSER_SERVER_CPU_RESERVED_CPUS=1
EXACT_TYPE1_PARSER_SERVER_CPU_IMAGE=vllm/vllm-openai-cpu:latest-x86_64
EXACT_TYPE1_PARSER_SERVER_DOCKER_MEMORY=8g


# ============================================================
# Main LLM generation defaults
# ============================================================

EXACT_LLM_TEMPERATURE=0.1
EXACT_LLM_TOP_P=0.9
EXACT_MAX_NEW_TOKENS=2048


# ============================================================
# Type 2 pipeline generation limits
# All values fit inside VLLM_MAX_MODEL_LEN=8192
# ============================================================

EXACT_TYPE2_EXTRACTION_MAX_TOKENS=768
EXACT_TYPE2_FORMULA_SELECTION_MAX_TOKENS=768
EXACT_TYPE2_CONCEPTUAL_MAX_TOKENS=1024
EXACT_TYPE2_POT_CODE_MAX_TOKENS=3072
EXACT_TYPE2_POT_REPAIR_MAX_TOKENS=2048
EXACT_TYPE2_FINAL_EXPLANATION_MAX_TOKENS=768


# ============================================================
# Offline and test mode
# ============================================================

MOCK_LLM=0
EXACT_MOCK_LLM=false
